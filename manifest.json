{
  "manifest_version": 3,
  "name": "Arizona Forum Styler",
  "version": "1.10",
  "background": {
    "service_worker": "background.js"
  },
  "description": "Стилизатор для форума Arizona RP. 80+ готовых тем, редактор цветов, кастомизация фона (фото/видео), эффекты, курсоры и твики.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://forum.arizona-rp.com/*",
    "*://*.forum.arizona-rp.com/*",
    "https://arizona-ai.ru/*",
    "https://arizona-ai.tech/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://forum.arizona-rp.com/*",
        "*://*.forum.arizona-rp.com/*"
      ],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
